---
// src/pages/blog/[id].astro → /blog/astro-basics/, /blog/mijn-eerste-post/, ...
// één bestand, één pagina per entry. Vervangt de losse mijn-eerste-post.astro uit les 04.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // getStaticPaths() draait apart, vóór de pagina: de collection ophalen moet HIER.
  // Dezelfde filter als op /blog/, anders krijgen drafts toch een (geheime) pagina.
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate - a.data.pubDate);

  // één object per entry = één pagina
  return posts.map((post, index) => ({
    // params: de URL. De sleutel "id" = de naam tussen de haken in de bestandsnaam
    params: { id: post.id },
    // props: de gegevens voor die ene pagina, komen terug in Astro.props
    props: {
      post,
      previous: posts[index + 1], // ouder (undefined bij de oudste post)
      next: posts[index - 1], // nieuwer (undefined bij de nieuwste post)
    },
  }));
}

const { post, previous, next } = Astro.props;
// render() geeft de <Content />-component terug: de markdown onder de frontmatter
const { Content } = await render(post);

const { title, pubDate, readingTime, image, imageAlt } = post.data;
const displayDate = pubDate.toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title}>
  <article class="c-article">
    <Image class="c-article__image" src={image} alt={imageAlt} widths={[800, 1200]} sizes="(width >= 48rem) 48rem, 100vw" />
    <h1 class="c-article__title">{title}</h1>
    <p class="c-article__meta">
      <time datetime={pubDate.toISOString().slice(0, 10)}>{displayDate}</time> · {readingTime} min lezen
    </p>

    <!-- markdown heeft geen classes: de wrapper .c-content stylet de kale elementen -->
    <div class="c-content">
      <Content />
    </div>

    <!-- vorige/volgende: enkel tonen als die post bestaat -->
    <nav class="c-post-nav" aria-label="Andere posts">
      {previous && (
        <a href={`/blog/${previous.id}/`} class="c-post-nav__link">← {previous.data.title}</a>
      )}
      {next && (
        <a href={`/blog/${next.id}/`} class="c-post-nav__link c-post-nav__link--next">{next.data.title} →</a>
      )}
    </nav>

    <a href="/blog/" class="c-article__back">← Alle posts</a>
  </article>
</BaseLayout>
